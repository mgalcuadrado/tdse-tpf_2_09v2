/**
  * @brief Redirección de printf hacia ITM/SWO.
  */
int _write(int file, char *ptr, int len)
{

  (void)file;


  for (int DataIdx = 0;
       DataIdx < len;
       DataIdx++)
  {
    ITM_SendChar(*ptr++);
  }


  return len;
}


/**
  * @brief Escaneo de dispositivos I2C.
  */
void scan_i2c(void)
{

    for (uint8_t i = 1;
         i < 128;
         i++)
    {

        if (HAL_I2C_IsDeviceReady(
                &hi2c1,
                (i << 1),
                1,
                10)
            == HAL_OK)
        {

            printf(
                "Device found at 0x%02X\r\n",
                i);
        }
    }
}


/**
  * @brief Interrupción periódica del TIM3.
  *
  * IMPORTANTE:
  *
  * Esta interrupción NO ejecuta tareas.
  *
  * Solamente actualiza:
  *
  *     pendientes_matriz
  *     contador_adc
  *     flag_adc
  */
void HAL_TIM_PeriodElapsedCallback(
    TIM_HandleTypeDef *htim)
{

    if (htim->Instance == TIM3)
    {

        //TAREA MATRIZ
        //Una ejecución pendiente por tick.
         
        pendientes_matriz++;

        //TAREA ADC
        //Cada 10 ticks: 10 x 1.024 ms = 10.24 ms

        contador_adc++;

        if (contador_adc >= ADC_TICKS_PERIODO)
        {

            contador_adc = 0;

            flag_adc = 1;
        }
    }
}


