/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

    /* USER CODE BEGIN 1 */
    /* USER CODE END 1 */


    /* MCU Configuration */

    HAL_Init();


    /* USER CODE BEGIN Init */
    /* USER CODE END Init */


    /* Configure the system clock */

    SystemClock_Config();


    //INICIALIZACIÓN CONTADOR DE CICLOS
    DWT_Init();


    /* USER CODE BEGIN SysInit */

    //Inicialización del framebuffer.
    frameBufferInit();

    /* USER CODE END SysInit */


    //INICIALIZACIÓN PERIFÉRICOS

    MX_GPIO_Init();

    MX_DMA_Init();

    MX_ADC1_Init();

    MX_I2C1_Init();

    MX_TIM3_Init();


    /* USER CODE BEGIN 2 */


    //INICIALIZACIÓN DE MÓDULOS DEL PROYECTO

    pote_init();

    hub75Init();

    lcdInicializar(&hi2c1);

    sistemaInit();

    printf("SISTEMA STM32 INICIADO\r\n");
    printf("CPU: %lu MHz\r\n",(unsigned long)CPU_FREQ_MHZ);
    printf("SWV funcionando!\r\n");


    //INICIO TIMER
    /*TIM3 genera una interrupción cada 1.024 ms. La interrupción solamente genera:
     *     pendientes_matriz
     *     flag_adc
     * Las tareas se ejecutan posteriormente dentro del while(1).*/

    HAL_TIM_Base_Start_IT(&htim3);


    /* USER CODE END 2 */


    /* Infinite loop */

    while (1)
    {

        //EJECUCIÓN DEL TEST WCET (se ejecuta una única vez)
        //Antes de medir se detiene TIM3 para evitar que una interrupción periódica interfiera con la medición.

        if (!test_wcet_ejecutado) {
            test_wcet_ejecutado = 1;
		//Detener temporalmente el TIM3.
			HAL_TIM_Base_Stop_IT(&htim3);
			printf("       INICIO TEST WCET\r\n");
			//SELECCIÓN DEL TEST
			#if TEST_WCET_ACTIVO == 1
            	testWCETHUB75();
			#elif TEST_WCET_ACTIVO == 2
            	testWCETADC();
			#elif TEST_WCET_ACTIVO == 3
            	testWCETBoton();
			#elif TEST_WCET_ACTIVO == 4
            //Indicar qué evento de botón se quiere utilizar.
            //El valor depende de boton.h.

            printf("Test de sistema seleccionado.\r\n");
            printf("Configurar evento de boton en main.c\r\n");

			#endif

            printf("FIN TEST WCET\r\n");

            HAL_TIM_Base_Start_IT(&htim3);
        }


        //TAREA MATRIZ
        if (pendientes_matriz > 0) {
            pendientes_matriz--;
            hub75Refresh();
        }

        //TAREA ADC
        if (flag_adc) {
            flag_adc = 0;

            uint8_t r;
            uint8_t g;
            uint8_t b;

            leer_potenciometros(&r, &g, &b);
        }


        //BOTONES
        BotonEvento_t btn = botonLeer();

        if (btn != BOTON_NINGUNO) {

            //SISTEMA
            sistemaTick(btn);


            /*Si se necesita acceder a la matriz activa:
             Matriz_t *pMatriz = sistemaObtenerMatrizActiva();
             if (pMatriz != NULL) {
                  ...
             }
             */
        }
        //FIN DEL WHILE
    }
    /* USER CODE END 3 */
}



