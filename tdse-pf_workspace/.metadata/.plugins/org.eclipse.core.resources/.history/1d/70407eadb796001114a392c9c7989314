#include POTENCIOMETRO_H
#include <stdlib.h>

#include "stm32f4xx_hal.h" // ajustá al header de tu familia (f1, l4, etc.)

extern ADC_HandleTypeDef hadc1;

static uint8_t leer_canal_adc(uint32_t canal)
{
    ADC_ChannelConfTypeDef sConfig = {0};

    sConfig.Channel      = canal;
    sConfig.Rank         = ADC_REGULAR_RANK_1;
    sConfig.SamplingTime = ADC_SAMPLETIME_15CYCLES; // ajustá según tu clock/precisión deseada

    if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
    {
        return 0; // podrías manejar el error como prefieras
    }

    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY);
    uint32_t valor_12bits = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);

    return (uint8_t)(valor_12bits >> 4); // 12 bits -> 8 bits
}

void leer_potenciometros(uint8_t *r, uint8_t *g, uint8_t *b)
{
    *r = leer_canal_adc(ADC_CHANNEL_0); // PA0 -> POTR
    *g = leer_canal_adc(ADC_CHANNEL_1); // PA1 -> POTG
    *b = leer_canal_adc(ADC_CHANNEL_4); // PA4 -> POTB
}